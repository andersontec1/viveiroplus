{
  "firestore": {
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "viveiroplusweb",
      "public": "build/web",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        { "source": "/index.html", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
        { "source": "/flutter_service_worker.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
  { "source": "/flutter_bootstrap.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
  { "source": "/flutter.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
  { "source": "/main.dart.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
        { "source": "**/*.{js,css,wasm,png,jpg,jpeg,svg,webp}", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] }
      ],
      "rewrites": [ { "source": "**", "destination": "/index.html" } ]
    },
    {
      "site": "viveiroplus",
      "redirects": [
        {
          "source": "/**",
          "destination": "https://viveiroplusweb.web.app",
          "type": 301
        }
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "viveiroplus",
          "appId": "1:729578249550:android:e9d211d0349d676c19d21f",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "viveiroplus",
          "configurations": {
            "android": "1:729578249550:android:e9d211d0349d676c19d21f",
            "ios": "1:729578249550:ios:80ffcef6842fe04519d21f",
            "macos": "1:729578249550:ios:80ffcef6842fe04519d21f",
            "web": "1:729578249550:web:af23f6d5bb7650c219d21f",
            "windows": "1:729578249550:web:510456b7bf1792e419d21f"
          }
        }
      }
    }
  }
}