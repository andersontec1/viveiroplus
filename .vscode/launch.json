{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Chrome (HTML renderer)",
      "type": "dart",
      "request": "launch",
      "deviceId": "chrome",
      "args": ["--web-renderer", "html"]
    },
    {
      "name": "Flutter Chrome (CanvasKit local)",
      "type": "dart",
      "request": "launch",
      "deviceId": "chrome",
      "args": [
        "--web-renderer", "canvaskit",
        "--dart-define=FLUTTER_WEB_CANVASKIT_URL=canvaskit/"
      ]
    }
  ]
}
